<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.astra</groupId>
    <artifactId>astra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>astra-server</artifactId>
  <name>Astra Server</name>
  <description>Runnable composition: kernel + DocType engine + IAM + first-party apps</description>

  <dependencies>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-doctype</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-plugin-host</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-ai</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-tx-seata</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-app-cms</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-iam</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-app-express</artifactId>
    </dependency>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-app-hrm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security-oidc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
