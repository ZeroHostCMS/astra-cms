<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.astra</groupId>
  <artifactId>astra-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Astra BOM</name>
  <description>Pins Quarkus and Astra module versions for apps and plugins</description>

  <properties>
    <quarkus.platform.version>3.39.5</quarkus.platform.version>
    <!-- Timefold 2.7.x is built against Quarkus 3.39 and runs on JDK 21+. -->
    <timefold.version>2.7.1</timefold.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>ai.timefold.solver</groupId>
        <artifactId>timefold-solver-bom</artifactId>
        <version>${timefold.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-spi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-doctype</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-app-cms</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-plugin-host</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-tx-seata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-iam</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-app-express</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-app-hrm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.astra</groupId>
        <artifactId>astra-app-stms</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
