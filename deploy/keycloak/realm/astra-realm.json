{
  "realm": "astra",
  "enabled": true,
  "displayName": "Astra",
  "displayNameHtml": "Astra",
  "loginTheme": "astra",
  "internationalizationEnabled": true,
  "supportedLocales": ["vi", "en"],
  "defaultLocale": "vi",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Manages tenants and their members. Grants no access to tenant documents." },
      { "name": "scim", "description": "SCIM 2.0 provisioning client. Held only by the service account of a tenant-scoped scim-<tenant> client, whose token names the tenant in the scim_tenant claim." }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "subGroups": [
        {
          "name": "acme",
          "attributes": { "display-name": ["Acme Vietnam"], "public-signup": ["true"] },
          "subGroups": [ { "name": "admin" }, { "name": "editor" }, { "name": "author" }, { "name": "reader" } ]
        },
        {
          "name": "globex",
          "attributes": { "display-name": ["Globex"], "public-signup": ["false"] },
          "subGroups": [ { "name": "admin" }, { "name": "editor" }, { "name": "author" }, { "name": "reader" } ]
        },
        {
          "name": "saigon-express",
          "attributes": { "display-name": ["Saigon Express"], "public-signup": ["false"] },
          "subGroups": [ { "name": "admin" }, { "name": "sales" }, { "name": "ops" }, { "name": "care" }, { "name": "accountant" }, { "name": "hr" }, { "name": "dispatcher" } ]
        },
        {
          "name": "hanoi-express",
          "attributes": { "display-name": ["Hanoi Express"], "public-signup": ["false"] },
          "subGroups": [ { "name": "admin" }, { "name": "sales" }, { "name": "ops" }, { "name": "care" }, { "name": "accountant" }, { "name": "hr" }, { "name": "dispatcher" } ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "astra-mobile",
      "name": "Astra mobile app",
      "description": "Public client for the Flutter app: Authorization Code + PKCE (S256) through the system browser.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["io.astra.mobile:/oauthredirect"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "io.astra.mobile:/oauthredirect",
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins", "acr"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "astra-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "astra-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astra-desk",
      "name": "Astra Desk",
      "description": "Public client for the browser Desk served by astra-server: Authorization Code + PKCE (S256).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:8080/desk/*", "http://localhost:8081/desk/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/desk/*##http://localhost:8081/desk/*",
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins", "acr"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "astra-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "astra-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astra-dev-cli",
      "name": "Astra local CLI (local stack only)",
      "description": "Password grant for scripts/demo-iam.sh and the demo scripts; one-hour tokens so an MCP agent session lasts a recording. Never enable in a shared or production realm.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": { "use.refresh.tokens": "true", "access.token.lifespan": "3600" },
      "defaultClientScopes": ["basic", "profile", "email", "roles", "acr"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "astra-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "astra-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astra-server",
      "name": "Astra server",
      "description": "Resource server audience, and service account for tenant/member management via the Admin API.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "astra-server-local-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"]
    },
    {
      "clientId": "scim-acme",
      "name": "SCIM provisioning for tenant acme",
      "description": "Client credentials for an enterprise directory that provisions acme users through /scim/v2. The hardcoded scim_tenant claim binds every token to acme; the secret is local-only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "scim-acme-local-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "scim tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "scim_tenant",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "astra-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "astra-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "scim-globex",
      "name": "SCIM provisioning for tenant globex",
      "description": "Client credentials for an enterprise directory that provisions globex users through /scim/v2. The hardcoded scim_tenant claim binds every token to globex; the secret is local-only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "scim-globex-local-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "scim tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "scim_tenant",
            "claim.value": "globex",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "astra-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "astra-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "acme-corp",
      "displayName": "Acme Corp SSO",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "entityId": "urn:astra:sp",
        "idpEntityId": "http://localhost:8080/auth/realms/acme-corp-idp",
        "singleSignOnServiceUrl": "http://localhost:8080/auth/realms/acme-corp-idp/protocol/saml",
        "useMetadataDescriptorUrl": "true",
        "metadataDescriptorUrl": "http://localhost:8080/auth/realms/acme-corp-idp/protocol/saml/descriptor",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
        "principalType": "SUBJECT",
        "postBindingAuthnRequest": "true",
        "postBindingResponse": "true",
        "postBindingLogout": "true",
        "wantAuthnRequestsSigned": "false",
        "validateSignature": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "signatureAlgorithm": "RSA_SHA256",
        "allowCreate": "true",
        "forceAuthn": "false",
        "allowedClockSkew": "30",
        "syncMode": "FORCE",
        "guiOrder": "1"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "acme-corp username",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-username-idp-mapper",
      "config": { "syncMode": "INHERIT", "template": "${ALIAS}.${NAMEID}", "target": "LOCAL" }
    },
    {
      "name": "acme-corp email",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "email", "user.attribute": "email" }
    },
    {
      "name": "acme-corp firstName",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "firstName", "user.attribute": "firstName" }
    },
    {
      "name": "acme-corp lastName",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "INHERIT", "attribute.name": "lastName", "user.attribute": "lastName" }
    },
    {
      "name": "acme-corp admin",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-advanced-group-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attributes": "[{\"key\":\"memberOf\",\"value\":\"astra-admins\"}]",
        "are.attribute.values.regex": "false",
        "group": "/tenants/acme/admin"
      }
    },
    {
      "name": "acme-corp editor",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-advanced-group-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attributes": "[{\"key\":\"memberOf\",\"value\":\"astra-editors\"}]",
        "are.attribute.values.regex": "false",
        "group": "/tenants/acme/editor"
      }
    },
    {
      "name": "acme-corp author",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-advanced-group-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attributes": "[{\"key\":\"memberOf\",\"value\":\"astra-authors\"}]",
        "are.attribute.values.regex": "false",
        "group": "/tenants/acme/author"
      }
    },
    {
      "name": "acme-corp reader",
      "identityProviderAlias": "acme-corp",
      "identityProviderMapper": "saml-advanced-group-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attributes": "[{\"key\":\"memberOf\",\"value\":\"astra-readers\"}]",
        "are.attribute.values.regex": "false",
        "group": "/tenants/acme/reader"
      }
    }
  ],
