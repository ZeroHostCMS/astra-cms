<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.astra</groupId>
    <artifactId>astra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>astra-express-integrations</artifactId>
  <packaging>pom</packaging>
  <name>Astra Express: Tier 1 integration plugins (demo)</name>
  <description>Carrier and e-invoice plugins loaded at run time into isolated class loaders. Each module is one version
    of one plugin, built as a plain jar that depends on astra-spi only; scripts/build-plugins.sh collects the jars.</description>

  <modules>
    <module>fastship-1.0.0</module>
    <module>fastship-1.1.0</module>
    <module>fastship-1.2.0-bad</module>
    <module>einvoice-vn</module>
    <module>einvoice-kh</module>
  </modules>

  <dependencies>
    <dependency>
      <groupId>io.astra</groupId>
      <artifactId>astra-spi</artifactId>
      <scope>provided</scope>   <!-- the host provides the SPI; the jar carries only the plugin's own classes -->
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
  </build>
</project>
